NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://trex:trex@localhost:5432/trex_platform
REDIS_URL=redis://localhost:6379
# Change before any non-local deployment. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3001,https://www.trextea.com.tr
# Optional storefront server-side source for live products. Leave blank until the API is deployed.
# TREX_API_URL=https://api.trextea.com.tr
# Permanent media storage stays disabled until these R2 values are set as server secrets.
# ASSET_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trex-media
# R2_PUBLIC_BASE_URL=https://media.trextea.com.tr
# integration modes deliberately default to safe stubs
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
# Use these only once to run npm run bootstrap:admin; never commit a real password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-12-or-more-characters
